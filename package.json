{
  "name": "@agentswap/cli",
  "version": "0.1.2",
  "private": false,
  "description": "Agentswap CLI and MCP server for gated token and liquidity operations on BSC through Binance Agentic Wallet.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentic-labs-hq/agentswap-cli.git"
  },
  "homepage": "https://github.com/agentic-labs-hq/agentswap-cli#readme",
  "bugs": {
    "url": "https://github.com/agentic-labs-hq/agentswap-cli/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "agentswap": "dist/cli.js",
    "agentswap-mcp": "dist/mcp.js",
    "cli": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "deployments",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "viem": "2.57.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "author": "Agentswap contributors"
}
